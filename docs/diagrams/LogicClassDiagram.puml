@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor LOGIC_COLOR_T4
skinparam classBackgroundColor LOGIC_COLOR
skinparam nodesep 40
skinparam ranksep 55

package Logic as LogicPackage {

package "Parser Classes" as ParserClasses{
}
Class XYZCommand
Class CommandResult
Class "{abstract}\nCommand" as Command


Class "<<interface>>\nLogic" as Logic
Class LogicManager
Class ReminderService

note as CommandExamples
  XYZCommand = AddCommand,
  SearchCommand, etc.
end note
CommandExamples -[hidden]down-> LogicManager
CommandExamples -[hidden,norank]-> ReminderService
}

package Model {
}

package Storage {
}

Class HiddenOutside #FFFFFF
HiddenOutside ..> Logic

LogicManager ..|> Logic
LogicManager --> "1" ParserClasses
ParserClasses ..> XYZCommand : <<create>>

XYZCommand --|> Command
LogicManager ..> Command : <<call>>

LogicManager --> Model
LogicManager --> Storage
LogicManager *--> "1" ReminderService
ReminderService --> Model
ReminderService --> Storage
Command ..> Model

Logic ..> CommandResult
LogicManager ..> CommandResult
Command ..> CommandResult : <<create>>

@enduml
