@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR
skinparam nodesep 45
skinparam ranksep 70
skinparam linetype polyline

Package Model as ModelPackage <<Rectangle>>{
Class CoordiMate
Class Person
Class Name
Class Event
Class EventTime
Class "<<enumeration>>\nAttendanceStatus" as AttendanceStatus
}

CoordiMate --> "~*" Person
CoordiMate --> "~*" Event

Person *--> "1" Name

Event *--right--> "1" EventTime : endTime\n
Event *--right--> "1" EventTime : startTime\n
Event *--right--> "0..*" EventTime : dismissedReminderStarts\n
Event --> "~*" Name : members {ordered}
Event --> "0..*" AttendanceStatus : attendance

note bottom of AttendanceStatus
  attendance is keyed by assigned member names;
  each member has zero or one recorded status.
end note

Person -[hidden]right-> Event
EventTime -[hidden]right-> AttendanceStatus
@enduml
