@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":CoordiMateParser" as CoordiMateParser LOGIC_COLOR
participant "d:DeleteCommand" as DeleteCommand LOGIC_COLOR
end box

box Storage STORAGE_COLOR_T1
participant ":Storage" as Storage STORAGE_COLOR
end box

[-> LogicManager : execute("delete 1")
activate LogicManager

LogicManager -> CoordiMateParser : parseCommand("delete 1")
activate CoordiMateParser
CoordiMateParser --> LogicManager : d
deactivate CoordiMateParser

LogicManager -> Storage : readCoordiMate()
activate Storage
Storage --> LogicManager : loaded
deactivate Storage

LogicManager -> DeleteCommand : resolvePerson(model)
activate DeleteCommand
DeleteCommand --> LogicManager : p
deactivate DeleteCommand
note right of LogicManager : Resolve ID 1 to p; pendingDelete = p
[<-- LogicManager : confirmation prompt for p
deactivate LogicManager

[-> LogicManager : execute(response)
activate LogicManager
note right of LogicManager : Clear pendingDelete; do not parse response
alt response is y or Y
note over LogicManager, Storage
  c = DeleteCommand.forResolvedPerson(p).
  c deletes p on the candidate model.
end note
ref over LogicManager, Storage
  executeAtomicCommand
end ref

[<-- LogicManager : deletion result
else any other response
note right of LogicManager
  Leave data unchanged; return MESSAGE_DELETE_CANCELLED.
end note
[<-- LogicManager : cancellation result
end
deactivate LogicManager
@enduml
