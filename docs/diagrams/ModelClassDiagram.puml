@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR

Package Model as ModelPackage <<Rectangle>>{
Class "<<interface>>\nReadOnlyCoordiMate" as ReadOnlyCoordiMate
Class "<<interface>>\nReadOnlyUserPrefs" as ReadOnlyUserPrefs
Class "<<interface>>\nModel" as Model
Class CoordiMate
Class ModelManager
Class UserPrefs

Class UniquePersonList
Class UniqueTagList
Class Event
Class Person
Class MemberId
Class Name
Class Phone
Class Email
Class Role
Class Birthday
Class Address
Class Organisation
Class Note
Class LeaveDate
Class Tag
note "Compared by value;\nnot necessarily the same\nobjects as in UniqueTagList." as TagNote

Class I #FFFFFF
}

Class HiddenOutside #FFFFFF
HiddenOutside ..> Model

CoordiMate .up.|> ReadOnlyCoordiMate

ModelManager .up.|> Model
Model .right.> ReadOnlyUserPrefs
Model .left.> ReadOnlyCoordiMate
ModelManager -left-> "1" CoordiMate
ModelManager -right-> "1" UserPrefs
UserPrefs .up.|> ReadOnlyUserPrefs

CoordiMate *--> "1" UniquePersonList
CoordiMate *--> "1" UniqueTagList
CoordiMate *--> "~*" Event
UniquePersonList --> "~* all" Person
UniqueTagList --> "~*" Tag
Person -left-> "~*" Tag

Person *--> "0..1" MemberId
Person *--> "1" Name
Person *--> "1" Phone
Person *--> "1" Email
Person *--> "1" Role
Person *---> "0..1" Birthday
Person *---> "0..1" Address
Person *---> "0..1" Organisation
Person *---> "0..1" Note
Person *---> "0..1" LeaveDate

TagNote .. Tag

Person -[hidden]up--> I
UniquePersonList -[hidden]right-> I

MemberId -[hidden]right-> Name
Name -[hidden]right-> Phone
Phone -[hidden]right-> Email
Email -[hidden]right-> Role
Birthday -[hidden]right-> Address
Address -[hidden]right-> Organisation
Organisation -[hidden]right-> Note
Note -[hidden]right-> LeaveDate
MemberId -[hidden]down- Birthday
Name -[hidden]down- Address
Phone -[hidden]down- Organisation
Email -[hidden]down- Note
Role -[hidden]down- LeaveDate

ModelManager --> "~* filtered" Person
@enduml
