@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant "d:DismissCommand" as DismissCommand LOGIC_COLOR
participant ":ReminderService" as ReminderService LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
end box

box Storage STORAGE_COLOR_T1
participant ":Storage" as Storage STORAGE_COLOR
end box

[-> LogicManager : execute("dismiss 1")
activate LogicManager

LogicManager -> DismissCommand : execute(m)
activate DismissCommand

DismissCommand -> ReminderService : getShownReminders()
activate ReminderService
ReminderService --> DismissCommand : shown reminders
deactivate ReminderService

note right of DismissCommand
  e is reminder 1 as shown in the panel.
end note

DismissCommand -> ReminderService : getReminders()
activate ReminderService
ReminderService --> DismissCommand : current reminders
deactivate ReminderService

note right of DismissCommand
  If e is no longer upcoming, a
  CommandException is thrown instead.
end note

DismissCommand -> ReminderService : dismissReminder(e)
activate ReminderService

ReminderService -> Storage : readCoordiMate()
activate Storage
Storage --> ReminderService
deactivate Storage

ReminderService -> Storage : saveCoordiMateIfUnchanged(copy with e dismissed)
activate Storage

alt save succeeded
    Storage --> ReminderService
    deactivate Storage
    ReminderService -> Model : setEvent(e, dismissed)
    activate Model
    Model --> ReminderService
    deactivate Model
    ReminderService --> DismissCommand
    DismissCommand --> LogicManager : success result
else the file changed in another window, or could not be saved
    Storage --> ReminderService : exception
    deactivate Storage
    ReminderService -> ReminderService : hide e for this session
    ReminderService --> DismissCommand : throw ReminderDismissalException
    DismissCommand --> LogicManager : "Not saved" warning result
end
deactivate ReminderService
deactivate DismissCommand

[<-- LogicManager
deactivate LogicManager
@enduml
