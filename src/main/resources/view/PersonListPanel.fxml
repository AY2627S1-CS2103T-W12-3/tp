<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<SplitPane fx:id="contactSplitPane" dividerPositions="0.43" minWidth="0" styleClass="contact-workspace"
           xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <items>
    <VBox fx:id="contactListSection" minWidth="300" styleClass="contact-list-section">
      <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="CONTACT LIST" styleClass="section-heading" />
        <Label fx:id="contactCount" id="contactCount" styleClass="detail-caption" />
      </HBox>
      <ListView fx:id="personListView" id="personListView" styleClass="contact-list" VBox.vgrow="ALWAYS" />
    </VBox>
    <VBox fx:id="contactDetailsSection" minWidth="460" styleClass="contact-details-section">
      <Label text="CONTACT DETAILS" styleClass="section-heading" />
      <Label fx:id="selectionHint" id="selectionHint" text="Select a contact to view details."
             wrapText="true" styleClass="contact-selection-hint" />
      <ScrollPane fx:id="detailsScroll" id="detailsScroll" fitToWidth="true"
                  styleClass="contact-details-scroll" VBox.vgrow="ALWAYS">
        <content>
          <VBox spacing="24" styleClass="details-content">
            <HBox alignment="CENTER_LEFT" spacing="14" styleClass="contact-header">
              <Label fx:id="selectedAvatar" styleClass="contact-avatar" />
              <VBox spacing="4" minWidth="0" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="10">
                  <Label fx:id="selectedName" id="selectedName" wrapText="true" styleClass="contact-name" />
                  <Label fx:id="selectedIndex" id="selectedIndex" styleClass="detail-caption" />
                </HBox>
                <Label fx:id="selectedSubtitle" wrapText="true" styleClass="detail-caption" />
              </VBox>
              <FlowPane fx:id="detailTags" id="detailTags" alignment="CENTER_RIGHT" hgap="6" vgap="5"
                        prefWrapLength="130" maxWidth="150" styleClass="contact-detail-tags" />
            </HBox>
            <Region styleClass="section-divider" prefHeight="1" />
            <VBox spacing="10">
              <Label text="CONTACT DETAILS:" styleClass="accent-heading" />
              <GridPane hgap="28" vgap="20" styleClass="contact-details-card">
                <columnConstraints>
                  <ColumnConstraints percentWidth="46" />
                  <ColumnConstraints percentWidth="46" />
                </columnConstraints>
                <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
                  <Label text="Phone" styleClass="detail-caption" />
                  <Label fx:id="phone" id="phone" wrapText="true" styleClass="detail-value" />
                </VBox>
                <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
                  <Label text="Email" styleClass="detail-caption" />
                  <Label fx:id="email" id="email" wrapText="true" styleClass="detail-value" />
                </VBox>
                <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="1">
                  <Label text="Role" styleClass="detail-caption" />
                  <Label fx:id="role" id="role" wrapText="true" styleClass="detail-value" />
                </VBox>
                <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="1">
                  <Label text="Organisation" styleClass="detail-caption" />
                  <Label fx:id="organisation" id="organisation" wrapText="true" styleClass="detail-value" />
                </VBox>
                <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="2">
                  <Label text="Birthday" styleClass="detail-caption" />
                  <Label fx:id="birthday" id="birthday" wrapText="true" styleClass="detail-value" />
                </VBox>
                <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="2">
                  <Label text="Address" styleClass="detail-caption" />
                  <Label fx:id="address" id="address" wrapText="true" styleClass="detail-value" />
                </VBox>
              </GridPane>
            </VBox>
            <VBox spacing="10">
              <Label text="NOTE:" styleClass="accent-heading" />
              <Label fx:id="note" id="note" wrapText="true" maxWidth="Infinity" styleClass="detail-value, note-card" />
            </VBox>
            <VBox spacing="10">
              <HBox alignment="CENTER_LEFT">
                <Label text="ASSIGNED EVENTS:" styleClass="accent-heading" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="assignedEventCount" styleClass="detail-caption" />
              </HBox>
              <VBox fx:id="assignedEvents" spacing="8" />
            </VBox>
          </VBox>
        </content>
      </ScrollPane>
    </VBox>
  </items>
</SplitPane>
