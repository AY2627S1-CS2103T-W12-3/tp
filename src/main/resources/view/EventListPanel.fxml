<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<SplitPane fx:id="eventSplitPane" dividerPositions="0.43" styleClass="event-workspace"
           xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <VBox spacing="12" minWidth="300" minHeight="0" styleClass="event-list-section">
    <Label fx:id="eventCount" text="Events" styleClass="section-heading" />
    <ListView fx:id="eventListView" VBox.vgrow="ALWAYS" minWidth="0" minHeight="0"
              accessibleText="Events. Select an event to view its details." styleClass="event-list" />
  </VBox>
  <ScrollPane fitToWidth="true" minWidth="460" minHeight="0" styleClass="event-details-scroll">
    <VBox spacing="24" styleClass="event-details-section">
      <Label text="EVENT DETAILS" styleClass="section-heading" />
      <VBox fx:id="eventDetails" spacing="24">
        <HBox alignment="CENTER_LEFT" spacing="14" styleClass="event-header">
          <Label text="▣" styleClass="event-avatar" />
          <Label fx:id="selectedName" text="No event selected" wrapText="true" styleClass="event-title" />
        </HBox>
        <Region styleClass="section-divider" prefHeight="1" />
        <VBox spacing="10">
          <Label text="EVENT TIMING:" styleClass="accent-heading" />
          <GridPane hgap="12" vgap="12" styleClass="event-details-card">
            <columnConstraints>
              <ColumnConstraints percentWidth="48" />
              <ColumnConstraints percentWidth="48" />
            </columnConstraints>
            <VBox spacing="6" styleClass="time-tile" GridPane.columnIndex="0" GridPane.rowIndex="0">
              <Label text="START TIME" styleClass="detail-caption" />
              <Label fx:id="startTime" wrapText="true" styleClass="detail-value" />
            </VBox>
            <VBox spacing="6" styleClass="time-tile" GridPane.columnIndex="1" GridPane.rowIndex="0">
              <Label text="END TIME" styleClass="detail-caption" />
              <Label fx:id="endTime" wrapText="true" styleClass="detail-value" />
            </VBox>
            <HBox spacing="8" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="1">
              <Label text="Duration:" styleClass="detail-caption" />
              <Label fx:id="duration" wrapText="true" styleClass="detail-value" />
            </HBox>
          </GridPane>
        </VBox>
        <VBox spacing="10">
          <HBox alignment="CENTER_LEFT" spacing="12">
            <Label fx:id="memberCount" text="Members" styleClass="accent-heading" />
            <Region HBox.hgrow="ALWAYS" />
            <FlowPane hgap="10" vgap="4" alignment="CENTER_RIGHT">
              <Label fx:id="presentCount" styleClass="attendance-present-text" />
              <Label fx:id="absentCount" styleClass="attendance-absent-text" />
              <Label fx:id="notMarkedCount" styleClass="attendance-unmarked-text" />
            </FlowPane>
          </HBox>
          <VBox fx:id="members" spacing="8" />
        </VBox>
      </VBox>
      <Label fx:id="selectionHint" text="Add an event with addevent to see its details here."
             wrapText="true" styleClass="detail-caption" />
    </VBox>
  </ScrollPane>
</SplitPane>
