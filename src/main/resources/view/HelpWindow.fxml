<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Scene?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.stage.Stage?>

<fx:root minHeight="450.0" minWidth="680.0" resizable="true" title="Help" type="javafx.stage.Stage"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <icons>
    <Image url="@/images/help_icon.png" />
  </icons>
  <scene>
    <Scene>
      <stylesheets>
        <URL value="@HelpWindow.css" />
      </stylesheets>

      <VBox fx:id="helpMessageContainer" prefHeight="600.0" prefWidth="800.0" spacing="10.0">
        <children>
          <Label alignment="CENTER" maxWidth="Infinity" styleClass="help-heading"
                 text="Command quick reference" />
          <VBox fx:id="keyboardHelp" spacing="3.0" styleClass="keyboard-help"
                accessibleText="Command mode is the default. Press Escape to enter Navigation mode. In Navigation mode, press J for the next card, K for the previous card, or I to focus the command box. Clicking the command box enters Command mode; clicking a card list enters Navigation mode.">
            <children>
              <Label styleClass="keyboard-help-heading" text="Keyboard navigation" />
              <Label fx:id="commandModeHelp" maxWidth="Infinity" styleClass="keyboard-help-text"
                     text="Command mode (default): type commands; press Esc to navigate cards."
                     wrapText="true" />
              <Label fx:id="navigationModeHelp" maxWidth="Infinity" styleClass="keyboard-help-text"
                     text="Navigation mode: press j for next, k for previous, or i to focus the command box. Click the command box or a card list to switch modes."
                     wrapText="true" />
            </children>
          </VBox>
          <Label fx:id="syntaxNote" styleClass="syntax-note"
                 text="Note: [ ] marks optional parameters; (A | B) means choose one. For edit, provide at least one field or tag operation. For editevent, provide at least one field."
                 wrapText="true" />
          <TableView fx:id="commandTable" accessibleText="Available commands and their usage formats."
                     editable="false" VBox.vgrow="ALWAYS">
            <columns>
              <TableColumn fx:id="commandColumn" minWidth="120.0" prefWidth="140.0" text="Command" />
              <TableColumn fx:id="usageColumn" minWidth="500.0" prefWidth="620.0" text="Usage format" />
            </columns>
          </TableView>
          <Separator />
          <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
              <Label fx:id="helpMessage" text="Label" wrapText="true" HBox.hgrow="ALWAYS" />
              <Button fx:id="tutorialButton" mnemonicParsing="false" onAction="#openTutorial"
                      text="Tutorial" accessibleText="Open the CoordiMate tutorial" />
              <Button fx:id="copyButton" mnemonicParsing="false" onAction="#copyUrl" text="Copy URL" />
              <Button fx:id="closeButton" cancelButton="true" mnemonicParsing="false" onAction="#close"
                      text="Close" />
            </children>
          </HBox>
        </children>
        <padding>
          <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
        </padding>
      </VBox>
    </Scene>
  </scene>
</fx:root>
