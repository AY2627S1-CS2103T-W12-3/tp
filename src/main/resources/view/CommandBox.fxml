<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="8" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <HBox spacing="8" alignment="CENTER_LEFT">
    <TextField fx:id="commandTextField" onAction="#handleCommandEntered" promptText="Enter command here..."
               accessibleText="Command input" HBox.hgrow="ALWAYS" minWidth="0" />
    <Button fx:id="submitButton" text="Enter" onAction="#handleCommandEntered" accessibleText="Execute command" />
  </HBox>
</VBox>

